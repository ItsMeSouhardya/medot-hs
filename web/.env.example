# Configure a demo Neon database and the exact public origin.
# Keep actual values in ignored .env.local or the Render environment dashboard.
DATABASE_URL=
APP_ORIGIN=http://localhost:3000
# M2: Clerk pharmacy authentication. Empty allowlist denies all signed-in users.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
PHARMACY_ALLOWED_USER_IDS=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/pharmacy

# M4: server-side speech; keep the API key server-only.
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_v3
ELEVENLABS_VOICE_ID_EN=
ELEVENLABS_VOICE_ID_BN=
ELEVENLABS_VOICE_ID_HI=
ELEVENLABS_MAX_GENERATIONS_PER_DAY=100

# M6: homepage demo, once an explicitly fictional sample is activated.
DEMO_PUBLIC_TOKEN=
# E4: comma-separated, at most five independently read-back active fictional tags.
# Empty configuration keeps the finder usable through a deliberate reference scan.
FIND_DEMO_TOKENS=
SHARING_RATE_LIMIT_SECRET=

# Device web reminders. Both VAPID keys are a matching pair; only publicKey is sent to the browser.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://github.com/ItsMeSouhardya/medot-hs
REMINDER_CRON_SECRET=

# Optional operator-only deployment/scheduler tooling; never upload these keys to the app.
RENDER_API_KEY=
RENDER_SERVICE_URL=
CRON_JOB_API_KEY=
