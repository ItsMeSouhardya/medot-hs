# M1: configure a demo Neon database and temporary operator sign-in.
# Keep actual values in ignored .env.local or the Render environment dashboard.
DATABASE_URL=
APP_ORIGIN=http://localhost:3000
ADMIN_PASSWORD=
# At least 32 unpredictable characters; removed after Clerk cutover in M2.
SESSION_SECRET=

# M2: pharmacy authentication; not required by the imported M1 app.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
PHARMACY_ALLOWED_USER_IDS=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/pharmacy

# M4: server-side speech; keep the API key server-only.
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_v3
ELEVENLABS_VOICE_ID_EN=
ELEVENLABS_VOICE_ID_BN=
ELEVENLABS_VOICE_ID_HI=
ELEVENLABS_MAX_GENERATIONS_PER_DAY=100

# M6: homepage demo, once an explicitly fictional sample is activated.
DEMO_PUBLIC_TOKEN=
